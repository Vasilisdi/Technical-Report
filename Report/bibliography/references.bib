@article{Martz2001,
	abstract = {In the broadest sense reliability is associated with dependability, with successful operation or performance, and with the absence of failures of a device. Because it is usually impossible to predict exactly when such a device will fail under use conditions, reliability considers the failures to be randomly occurring events. Consequently, in the narrow sense, reliability is formally defined as the probability that a device or system (or even a person) successfully performs its intended function for the time period of interest when used under stated conditions. Qualitative reliability analysis is intended to identify the various failure modes and failure causes that contribute to the unreliability of the device. Quantitative reliability analysis utilizes pertinent failure data in conjunction with a reliability model to produce a numerical estimate of the device reliability. Reliability theory thus draws on the interdisciplinary use of probability, statistics, and mathematical modeling combined with engineering insights into the design, function, and failure characteristics of the device.},
	author = {Michael S. Hamada and Alyson G. Wilson and C. Shane Reese and Harry F. Martz},
	doi = {10.1007/978-0-387-77950-8},
	issn = {0172-7397},
	issue = {1},
	journal = {Springer New York, NY},
	keywords = {Availability,MTBF,MTTF,Reliability},
	month = {7},
	pages = {143-159},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	title = {Bayesian Reliability},
	volume = {1},
	year = {2001},
}

@inproceedings{Ruane2022,
	abstract = {Digitalization in manufacturing is the conversion of information into digital format, the integration of this digital data and technologies into the manufacturing process and the use of those technologies (eg: simulation) to change a business model to provide new revenue and value-producing opportunities. Digitalization may be seen as the increased generation, analysis, and use of data to improve the efficiency of the overall manufacturing system. Simulation in manufacturing is often applied in situations where conducting experiments on a real system is impossible or very difficult due to cost or time to carry out the experiment is too long. A key input to the simulation model of automated equipment is the acquisition of valid data in relation to cycle time and reliability of various workstations on this line. As a consequence of being able to simulate equipment processes and interact with this validated simulation model, both the understanding of how the production system will perform under varying reliability and cycle time conditions is achieved. The simulation model then enables the experimentation of ‘what if scenarios’ that can be tested easily, while also providing a valuable tool to inform the maintenance personnel what station reliabilities they need to target in order to sustain a high performing manufacturing line. The author has adopted an open source simulation tool (JaamSim) to develop a digital model of an automated production line in a Johnson and Johnson Vision Care (JJVC) manufacturing facility. This research demonstrated how a digital model was validated for use. The validated digital model can then be used by the author/facility engineering teams to perform scenario testing during the design stage of the line. This simulation model can also be used as a subset of an optimization system to determine recommended optimum line parameters to maximize line performance, either during the line design or when line is in operation.},
	author = {Patrick Ruane and Patrick Walsh and John Cosgrove},
	doi = {10.1016/j.ifacol.2022.09.195},
	issn = {24058963},
	issue = {19},
	journal = {IFAC-PapersOnLine},
	keywords = {Digital Model Validation,MTBF,MTTR,OEE,Reliability,Simulation Model},
	month = {7},
	pages = {127-132},
	publisher = {Elsevier B.V.},
	title = {Validation of a Digital Simulation Model for Maintenance in a High-Volume Automated Manufacturing Facility},
	booktitle = {5th IFAC Workshop on Advanced Maintenance Engineering, Services and Technologies AMEST 2022},
	volume = {55},
	year = {2022},
}


@inbook{Lilly2008,
   abstract = {This chapter presents several measures that need to be taken to avoid vibration problems, focuses on troubleshooting excessive vibration, and introduces vibration analysis and noise analysis. It is required to adequately balance all rotating components of diameter equal to at least one-third of the pump impeller diameter to avoid vibration problems. The entire rotor system should be check-balanced in the assembled condition. Accurate alignment is necessary to make the centerline of the driving and driven equipment coincide as closely as possible both in concentricity and parallelism. Design piping and pump supporting structures (including floors) should have natural frequencies that are at least 25% less or 25% more than the operating range of the key excitation frequencies in the pump. Rotordynamic analysis of the pump, compressor, or fan rotating system should be performed by the manufacturer or a third-party consultant. In performing vibration troubleshooting, generalized charts for matching symptoms to possible causes could be useful for many typical or simple problems but it is recommended not to rely too heavily on such lists, especially if their initial application does not lead to an immediate resolution of the problem. Vibration test data are usually plotted in three different forms that include a Cartesian plot of vibration amplitude versus frequency, a Cartesian plot of vibration amplitude versus time, similar to a typical oscilloscope trace, and a polar plot of vibration versus time in a plane perpendicular to the shaft axis.},
   author = {Jerry G. Lilly and William D. Marscher and Roger J. Cronin and Ray A. Gall and Richard O. Garbus and Willard O. Keightley and J. Davis Miller and Aloysius M. Mocek and William E. Nelson and Randall R. Parks and Jerry P. Pollack and James W. Schettler and Theodore B. Whiton},
   doi = {10.1016/B978-185617513-5.50029-9},
   edition = {3},
   isbn = {9780080560052},
   booktitle = {Pumping Station Design},
   month = {1},
   pages = {22.1-22.65},
   publisher = {Butterworth-Heinemann},
   title = {Vibration and Noise},
   url = {https://www.sciencedirect.com/science/article/pii/B9781856175135500299},
   year = {2008}
}


